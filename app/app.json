{
  "expo": {
    "name": "Sightline",
    "slug": "sightline",
    "version": "0.2.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "sightline",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.zachadams.sightline",
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Scan a QR code to connect to your Sightline Hub, a shared invite, or your home VPN.",
        "NSLocalNetworkUsageDescription": "Connect to cameras and recorders on your home network.",
        "NSMicrophoneUsageDescription": "Sightline uses the microphone only while you press Talk, so you can speak through your camera or doorbell, or while you speak a question to Ask.",
        "NSSpeechRecognitionUsageDescription": "Sightline turns your spoken question into text on your iPhone. Your voice never leaves your phone.",
        "NSBonjourServices": [
          "_http._tcp",
          "_rtsp._tcp"
        ],
        "UIBackgroundModes": [
          "fetch",
          "processing",
          "remote-notification"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "SightlineAppGroup": "group.com.zachadams.sightline",
        "NSSupportsLiveActivities": true,
        "ITSAppUsesNonExemptEncryption": true,
        "CFBundleAllowMixedLocalizations": true
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true,
        "com.apple.security.application-groups": [
          "group.com.zachadams.sightline"
        ],
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.com.zachadams.sightline"
        ],
        "com.apple.developer.icloud-services": [
          "CloudKit"
        ],
        "com.apple.developer.ubiquity-kvstore-identifier": "$(TeamIdentifierPrefix)com.zachadams.sightline"
      },
      "appleTeamId": "D36CEMNM8Q",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "locales": {
      "es": "./locales/es.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json",
      "pt-BR": "./locales/pt-BR.json"
    },
    "android": {
      "package": "com.zachadams.sightline",
      "adaptiveIcon": {
        "backgroundColor": "#080A14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "es",
              "fr",
              "de",
              "pt-BR"
            ],
            "android": [
              "en",
              "es",
              "fr",
              "de",
              "pt-BR"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080A14",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 300,
          "android": {
            "imageWidth": 288
          }
        }
      ],
      "expo-video",
      "expo-secure-store",
      "expo-background-task",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a QR code to connect to your Sightline Hub, a shared invite, or your home VPN.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7C5CFF",
          "icon": "./assets/images/notification-icon.png",
          "defaultChannel": "alerts"
        }
      ],
      "./plugins/with-android-network-security",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.1"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your cameras."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a floor plan or map image to place your cameras on, or photos of people and vehicles for Sightline to recognize on this iPhone.",
          "cameraPermission": "Scan a QR code to connect to your Sightline Hub, a shared invite, or your home VPN.",
          "microphonePermission": "Sightline uses the microphone only while you press Talk, so you can speak through your camera or doorbell, or while you speak a question to Ask."
        }
      ],
      "@bacons/apple-targets",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Sightline uses your location only to notice when you arrive home or leave, so it can quiet alerts while you're there. Your home's exact spot stays on your iPhone (and your own iCloud backup); your Sightline Hub only learns home or away and a rough area, about 10 km.",
          "locationWhenInUsePermission": "Set your home location so Sightline can quiet alerts while you're home. The exact spot stays on your iPhone (and your own iCloud backup).",
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.zachadams.sightline.notification-service",
                  "targetName": "NotificationService",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.zachadams.sightline"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "04a27cc2-1b54-4d42-a1e4-41869a5deea1"
      }
    },
    "owner": "zaadams095",
    "updates": {
      "url": "https://u.expo.dev/04a27cc2-1b54-4d42-a1e4-41869a5deea1"
    }
  }
}
