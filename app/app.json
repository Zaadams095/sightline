{
  "expo": {
    "name": "Sightline",
    "slug": "sightline",
    "version": "0.2.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "sightline",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.zachadams.sightline",
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Scan a QR code to connect to your Sightline Hub, a shared invite, or your home VPN.",
        "NSLocalNetworkUsageDescription": "Connect to cameras and recorders on your home network.",
        "NSMicrophoneUsageDescription": "Sightline uses the microphone only while you press Talk, so you can speak through your camera or doorbell.",
        "NSBonjourServices": [
          "_http._tcp",
          "_rtsp._tcp",
          "_http._tcp",
          "_rtsp._tcp",
          "_http._tcp",
          "_rtsp._tcp",
          "_http._tcp",
          "_rtsp._tcp"
        ],
        "UIBackgroundModes": [
          "fetch",
          "processing",
          "remote-notification",
          "fetch",
          "processing",
          "remote-notification",
          "fetch",
          "processing",
          "remote-notification",
          "fetch",
          "processing",
          "remote-notification"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "SightlineAppGroup": "group.com.zachadams.sightline",
        "NSSupportsLiveActivities": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true,
        "com.apple.security.application-groups": [
          "group.com.zachadams.sightline",
          "group.com.zachadams.sightline",
          "group.com.zachadams.sightline",
          "group.com.zachadams.sightline"
        ],
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.com.zachadams.sightline"
        ],
        "com.apple.developer.icloud-services": [
          "CloudKit"
        ],
        "com.apple.developer.ubiquity-kvstore-identifier": "$(TeamIdentifierPrefix)com.zachadams.sightline"
      },
      "appleTeamId": "D36CEMNM8Q",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "package": "com.zachadams.sightline",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-video",
      "expo-secure-store",
      "expo-background-task",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a QR code to connect to your Sightline Hub, a shared invite, or your home VPN.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7C5CFF"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.1"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your cameras."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a floor plan or map image to place your cameras on, or photos of people and vehicles for Sightline to recognize on this iPhone.",
          "cameraPermission": false,
          "microphonePermission": "Sightline uses the microphone only while you press Talk, so you can speak through your camera or doorbell."
        }
      ],
      "@bacons/apple-targets",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Sightline uses your location only to notice when you arrive or leave home, so it can quiet alerts while you're there. It never leaves your phone.",
          "locationWhenInUsePermission": "Set your home location so Sightline can quiet alerts while you're home.",
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.zachadams.sightline.notification-service",
                  "targetName": "NotificationService",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.zachadams.sightline"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "04a27cc2-1b54-4d42-a1e4-41869a5deea1"
      }
    },
    "owner": "zaadams095",
    "updates": {
      "url": "https://u.expo.dev/04a27cc2-1b54-4d42-a1e4-41869a5deea1"
    }
  }
}
