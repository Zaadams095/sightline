          "stringUnit": {
            "state": "translated",
            "value": "Rapprochez votre iPhone pour actualiser cette caméra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring dein iPhone näher, um diese Kamera zu aktualisieren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproxime seu iPhone para atualizar esta câmera."
          }
        }
      }
    },
