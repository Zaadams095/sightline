        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Sightline sur votre iPhone pour afficher vos caméras ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Sightline auf deinem iPhone, um deine Kameras hier zu sehen."
