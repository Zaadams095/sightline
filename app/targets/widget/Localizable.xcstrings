        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos récentes de vos caméras. Touchez-en une pour la voir en direct."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle Schnappschüsse deiner Kameras. Tippe auf einen, um live zuzusehen."
