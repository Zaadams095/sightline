    "No packages today, as far as Sightline has seen.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy no ha llegado ningún paquete, que Sightline haya visto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun colis aujourd’hui, d’après ce que Sightline a vu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute keine Pakete, soweit Sightline es gesehen hat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum pacote hoje, pelo que o Sightline viu."
          }
        }
      }
    },
    "Nobody right now, as far as I can tell. The last one was %@ at %@ %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no hay nadie, que yo sepa. La última vez fue %1$@ frente a la cámara %2$@ %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne pour l’instant, à ma connaissance. La dernière fois, c’était %1$@ devant la caméra %2$@ %3$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade ist niemand da, soweit ich sehe. Zuletzt war %1$@ %3$@ vor der Kamera %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém agora, pelo que vejo. A última vez foi %1$@ na frente da câmera %2$@ %3$@."
          }
        }
      }
    },
    "Nothing happened on %@ today, as far as Sightline has seen.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy no ha pasado nada en la cámara %@, que Sightline haya visto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne s’est passé aujourd’hui sur la caméra %@, d’après ce que Sightline a vu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute ist bei der Kamera %@ nichts passiert, soweit Sightline es gesehen hat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada aconteceu hoje na câmera %@, pelo que o Sightline viu."
          }
        }
      }
    },
