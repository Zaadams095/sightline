            "state": "translated",
            "value": "Quem está na porta?"
          }
        }
      }
    },
    "Yes, %lld packages look like they're still outside: %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí, parece que hay %1$lld paquetes todavía fuera: %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui, %1$lld colis ont l’air d’être encore dehors : %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, %1$lld Pakete scheinen noch draußen zu liegen: %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sim, parece que %1$lld pacotes ainda estão lá fora: %2$@."
          }
        }
      }
    },
    "Yes. A package was delivered to %@, and it looks like it's still there.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí. Dejaron un paquete frente a la cámara %@ y parece que sigue ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui. Un colis a été livré devant la caméra %@, et il a l’air d’être toujours là."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja. Ein Paket wurde bei der Kamera %@ abgelegt, und es sieht so aus, als wäre es noch da."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sim. Um pacote foi entregue na frente da câmera %@ e parece que ainda está lá."
          }
        }
      }
    },
    "Yes. A package was seen at %@ %@. It may have been picked up since.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí. Se vio un paquete frente a la cámara %1$@ %2$@. Puede que ya lo hayan recogido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui. Un colis a été vu devant la caméra %1$@ %2$@. Il a peut-être été récupéré depuis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja. Vor der Kamera %1$@ wurde %2$@ ein Paket gesehen. Vielleicht hat es inzwischen jemand reingeholt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sim. Um pacote foi visto na frente da câmera %1$@ %2$@. Talvez alguém já tenha pegado."
          }
        }
      }
    },
