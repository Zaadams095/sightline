    "Opens Sightline and answers a question about what your cameras saw, on your iPhone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Sightline y responde en tu iPhone a una pregunta sobre lo que vieron tus cámaras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Sightline et répond sur votre iPhone à une question sur ce que vos caméras ont vu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Sightline und beantwortet auf deinem iPhone eine Frage dazu, was deine Kameras gesehen haben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Sightline e responde no seu iPhone a uma pergunta sobre o que suas câmeras viram."
          }
        }
      }
    },
    "Opens all your cameras.": {
