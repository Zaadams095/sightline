    "Sightline last checked your cameras %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sightline revisó tus cámaras por última vez %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sightline a vérifié vos caméras pour la dernière fois %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sightline hat deine Kameras zuletzt %@ geprüft."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sightline verificou suas câmeras pela última vez %@."
          }
        }
      }
    },
    "Someone rang the doorbell at %@ %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien tocó el timbre (%1$@) %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On a sonné à la porte (%1$@) %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand hat %2$@ an der Tür geklingelt (%1$@)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém tocou a campainha (%1$@) %2$@."
          }
        }
      }
    },
    "Tells you what one of your cameras saw today.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te dice lo que vio hoy una de tus cámaras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous dit ce qu’une de vos caméras a vu aujourd’hui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagt dir, was eine deiner Kameras heute gesehen hat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz o que uma das suas câmeras viu hoje."
          }
        }
      }
    },
    "Tells you what your cameras saw today.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te dice lo que vieron hoy tus cámaras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous dit ce que vos caméras ont vu aujourd’hui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagt dir, was deine Kameras heute gesehen haben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz o que suas câmeras viram hoje."
          }
        }
      }
    },
    "Tells you whether a package came today and whether it looks like it's still outside.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te dice si hoy llegó un paquete y si parece que sigue fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous dit si un colis est arrivé aujourd’hui et s’il semble être encore dehors."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagt dir, ob heute ein Paket kam und ob es noch draußen zu liegen scheint."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz se chegou um pacote hoje e se parece que ainda está lá fora."
          }
        }
      }
    },
    "Tells you who was last seen at your door, with a picture.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te dice quién se vio por última vez en tu puerta, con una foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous dit qui a été vu en dernier à votre porte, avec une photo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagt dir, wer zuletzt an deiner Tür war – mit Bild."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz quem foi visto por último na sua porta, com uma foto."
          }
        }
      }
    },
