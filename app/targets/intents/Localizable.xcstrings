    "I don't have anything from your cameras yet. Open Sightline once, then ask again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no tengo nada de tus cámaras. Abre Sightline una vez y vuelve a preguntar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je n’ai encore rien reçu de vos caméras. Ouvrez Sightline une fois, puis reposez la question."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe noch nichts von deinen Kameras. Öffne Sightline einmal und frag dann noch mal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não tenho nada das suas câmeras. Abra o Sightline uma vez e pergunte de novo."
          }
        }
      }
    },
    "I haven't seen anyone at the door in the last two days.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No he visto a nadie en la puerta en los últimos dos días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je n’ai vu personne à la porte ces deux derniers jours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe in den letzten zwei Tagen niemanden an der Tür gesehen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não vi ninguém na porta nos últimos dois dias."
          }
        }
      }
    },
    "I haven't seen anyone in the last two days.": {
      "localizations": {
